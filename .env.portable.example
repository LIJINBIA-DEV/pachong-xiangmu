# Copy to .env.portable and edit. Do not send the populated file to others.
COMPOSE_PROJECT_NAME=mediacrawler-portable
APP_IMAGE=mediacrawler-portable:20261020-proxy
APP_BIND_IP=127.0.0.1
APP_PORT=18180
BROWSER_PORT=16080
# Exactly 8 ASCII letters/digits; startup scripts generate this on first run.
BROWSER_PASSWORD=
APP_CPUS=2.0
APP_MEMORY_LIMIT=4g
SILICONFLOW_API_KEY=
TYPESAFE_API_KEY=
# New image: configure the bundled Jev proxy in the workbench.
# This option is only for legacy images without MEDIACRAWLER_BUNDLED_PROXY=1.
TYPESAFE_PROXY_URL=
# Optional build mirrors when the default registries cannot be reached:
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim-bookworm
# BUILD_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# BUILD_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# BROWSER_DOWNLOAD_PROXY=http://host.docker.internal:7897
# MIHOMO_DOWNLOAD_PROXY=http://host.docker.internal:7897
