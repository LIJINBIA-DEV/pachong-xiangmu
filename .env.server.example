# Temporary US server. Secrets are configured at runtime, never in the image.
# No public binding: use an SSH tunnel until authenticated access is configured.
APP_BIND_IP=127.0.0.1
APP_PORT=18180
APP_IMAGE=mediacrawler-temp-us-app:local
APP_UID=1000
APP_GID=1000
APP_CPUS=2.0
APP_MEMORY_LIMIT=4g
NODE_IMAGE=node:24-bookworm-slim
PYTHON_IMAGE=python:3.11-slim-bookworm
BUILD_PIP_INDEX=https://pypi.org/simple
BUILD_DEBIAN_MIRROR=http://deb.debian.org/debian
SILICONFLOW_API_KEY=
TYPESAFE_API_KEY=
APP_DATA_DIR=./docker/runtime/data
APP_BROWSER_DIR=./docker/runtime/browser_data
APP_LOG_DIR=./docker/runtime/logs
