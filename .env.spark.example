# Copy to .env.spark on the Spark host, then edit. Never commit real credentials.
# Use Spark's LAN address for LAN access; never 0.0.0.0 for this deployment.
SPARK_BIND_IP=127.0.0.1
APP_PORT=18180
APP_IMAGE=mediacrawler-spark-app:local
APP_UID=1000
APP_GID=1000
# Bound only this new service; other containers and GPU services stay unchanged.
APP_CPUS=2.0
APP_MEMORY_LIMIT=8g
# Optional registry-mirror references for hosts without Docker Hub connectivity.
NODE_IMAGE=node:24-bookworm-slim
PYTHON_IMAGE=python:3.11-slim-bookworm
# Leave empty to enter the Jev key through the existing web form.
TYPESAFE_API_KEY=
# Image recognition uses SiliconFlow Qwen/Qwen3.5-4B, not Spark GPU.
SILICONFLOW_API_KEY=
# New, isolated directories on Spark. Do not point these at Windows old data.
SPARK_DATA_DIR=./docker/runtime/data
SPARK_BROWSER_DIR=./docker/runtime/browser_data
SPARK_LOG_DIR=./docker/runtime/logs
